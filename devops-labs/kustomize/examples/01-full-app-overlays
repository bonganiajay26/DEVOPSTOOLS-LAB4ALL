# Example 01: Complete Kustomize App with Multi-Environment Overlays
# Directory structure and all files

# ══════════════════════════════════════════
# Directory tree:
# apps/myapi/
# ├── base/
# │   ├── kustomization.yaml
# │   ├── deployment.yaml
# │   ├── service.yaml
# │   ├── configmap.yaml
# │   └── hpa.yaml
# ├── overlays/
# │   ├── development/
# │   │   ├── kustomization.yaml
# │   │   └── patches/
# │   │       └── dev-patch.yaml
# │   ├── staging/
# │   │   ├── kustomization.yaml
# │   │   └── patches/
# │   │       └── staging-patch.yaml
# │   └── production/
# │       ├── kustomization.yaml
# │       ├── hpa-patch.yaml
# │       └── resources-patch.yaml
# └── components/
#     ├── monitoring/
#     │   └── kustomization.yaml
#     └── security/
#         └── kustomization.yaml
