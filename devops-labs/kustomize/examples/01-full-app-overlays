# ── Usage commands ────────────────────────────────────────────
# Build and preview:
# kustomize build overlays/development/
# kustomize build overlays/staging/
# kustomize build overlays/production/

# Apply:
# kubectl apply -k overlays/production/

# In CI/CD — update image tag then apply:
# cd overlays/production
# kustomize edit set image myapi=ghcr.io/myorg/myapi:${GITHUB_SHA::7}
# git commit -am "deploy: update myapi to ${GITHUB_SHA::7}"
# git push
# (ArgoCD/Flux picks up the change)

# Diff before applying:
# kubectl diff -k overlays/production/
